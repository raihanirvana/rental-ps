# Alamat dan port server Express (API + build frontend).
HOST=127.0.0.1
PORT=3001
# Port Vite saat `npm run dev`; /api diteruskan ke PORT dengan Host asli.
WEB_PORT=5173
NODE_ENV=development
# File SQLite (relatif terhadap root proyek). Folder data/ tidak masuk Git.
DATABASE_PATH=./data/sesi-play.sqlite
# Umur workspace dan sesi demo dalam menit (default 12 jam).
DEMO_TTL_MINUTES=720
# Isi hanya di belakang reverse proxy HTTPS (jumlah hop atau alamat, mis. 1 / loopback).
# false: X-Forwarded-* diabaikan sehingga cookie Secure hanya untuk koneksi HTTPS langsung.
TRUST_PROXY=false
